# رابط قاعدة بيانات Postgres من Neon (Connection string)
# مثال: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# مفتاح سري لتشفير الجلسات، ٣٢ حرفًا على الأقل
# ولّده بالأمر: openssl rand -base64 32
BETTER_AUTH_SECRET=

# رابط الموقع. محليًا: http://localhost:3000
# على Vercel: رابط موقعك مثل https://smile-clinic.vercel.app
BETTER_AUTH_URL=http://localhost:3000
